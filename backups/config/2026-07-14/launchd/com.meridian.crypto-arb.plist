<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  [Phase 13: Global Alpha] com.meridian.crypto-arb.plist
  =========================================================
  S6-A 크립토 차익거래 데몬 — 24시간 15분 단위 실행

  독립 설계 원칙:
    - 주식 시장 스케줄러(com.meridian.market.plist)와 완전히 독립
    - KRX 휴장, 한국 공휴일과 무관하게 24시간 365일 실행
    - StartInterval: 900초(15분) = BTC 펀딩비 체크 최소 권장 주기

  실행 흐름:
    1. run_pipeline.sh crypto_arb 호출
    2. daily_pipeline.py _phase_crypto_arb() 실행
    3. CryptoDataBridge → build_kimchi_intel()
    4. CryptoArbStream → generate_signals()
    5. 시그널 → results/s6a_signal.json 저장

  설치:
    cp config/launchd/com.meridian.crypto-arb.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.meridian.crypto-arb.plist

  언로드:
    launchctl unload ~/Library/LaunchAgents/com.meridian.crypto-arb.plist
-->
<plist version="1.0">
<dict>
    <!-- 고유 레이블 -->
    <key>Label</key>
    <string>com.meridian.crypto-arb</string>

    <!-- 실행 명령 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sunghohong/.gemini/antigravity/playground/shimmering-interstellar/Project_Meridian/scripts/run_pipeline.sh</string>
        <string>crypto_arb</string>
    </array>

    <!--
        [Phase 13: Global Alpha] 24시간 15분 단위 실행
        StartInterval: 900초 = 15분
        주식 시장 스케줄러(StartCalendarInterval)와 달리
        StartInterval은 시장 유무와 무관하게 항상 실행됨.
    -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- 작업 디렉토리 -->
    <key>WorkingDirectory</key>
    <string>/Users/sunghohong/.gemini/antigravity/playground/shimmering-interstellar/Project_Meridian</string>

    <!-- 로그 -->
    <key>StandardOutPath</key>
    <string>/Users/sunghohong/.gemini/antigravity/playground/shimmering-interstellar/Project_Meridian/logs/com.meridian.crypto-arb.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sunghohong/.gemini/antigravity/playground/shimmering-interstellar/Project_Meridian/logs/com.meridian.crypto-arb.err.log</string>

    <!-- 환경 변수 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.12/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/sunghohong/.gemini/antigravity/playground/shimmering-interstellar/Project_Meridian</string>
    </dict>

    <!-- 실패 시 재시작 방지 (크래시 루프 방어) -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- 로그인 필요 없음 (백그라운드 실행) -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
